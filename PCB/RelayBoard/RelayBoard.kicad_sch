	(text "Board notes: MAINS + 5 V"
		(exclude_from_sim no)
		(at 214.63 125.73 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "30bec03d-561c-587f-bc17-f78c597c4254")
	)
	(text "J4: 4-way push-in terminal, 5.00 mm pitch\n(Phoenix PTS 1,5/4-5,0-H, 1792889).\nJ4 pins: 1 = L IN (fused line from the machine),\n2 = VALVE, 3 = COFFEE LAMP, 4 = STEAM LAMP.\nAll loads return to N in the machine wiring:\nno neutral on this board.\nL_IN feeds K1 / K2 COM and U1 pin 2."
		(exclude_from_sim no)
		(at 214.63 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "339a46ed-ae18-5f09-a05e-ab8240c93fce")
	)
	(text "D1 / D2: flyback diodes across each coil (SS14, K to 5 V), right at the coil.\nCOM = L_IN, NO = lamp output (closed while the channel is on). NC unused.\nJ103 contacts: 2 A at 120 VAC resistive, 125 VAC max: 120 V mains only."
		(exclude_from_sim no)
		(at 90.17 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "39509883-a4e9-578a-91b3-48f664184ffe")
	)
	(text "Valve SSR: Omron G3MB-202P (zero cross, built-in snubber)"
		(exclude_from_sim no)
		(at 90.17 125.73 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "48909319-4178-5b89-81c8-a9f20f9e7c2d")
	)
	(text "Lamp relays: CIT J103, 5 V / 30 mA coil"
		(exclude_from_sim no)
		(at 90.17 24.13 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "72808f1f-0cee-5fd6-b50d-28b0b17ee819")
	)
	(text "Hazardous voltage on L_IN, VALVE_L, *_LAMP_L, J4,\nrelay contacts and U1 pins 1-2.\nKeep mains copper and 5 V copper on separate\nsides of the board (>= 3 mm creepage, slot if needed).\nJ103 coil pins sit 2.54 mm from NO/NC (relay pinout):\nmains-to-5 V spacing there is set by the relay.\nMains traces: 2 A (>= 1 mm wide, 1 oz).\nJST XH (2.50 mm) for 5 V, 5 mm push-in terminal for mains."
		(exclude_from_sim no)
		(at 214.63 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8dc6b153-1a0d-57f5-ab38-6f7dc76086cb")
	)
	(text "Inputs from main board (5 V, JST XH)"
		(exclude_from_sim no)
		(at 13.97 24.13 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9b553a48-b41a-5219-90df-a8e3cdad4e56")
	)
	(text "J1 pins: 1 = 5 V, 2 = VALVE_D       (main board J3).\nJ2 pins: 1 = 5 V, 2 = LAMP_COFFEE_D (main board J4).\nJ3 pins: 1 = 5 V, 2 = LAMP_STEAM_D  (main board J5).\nStraight-through 2-wire XH cables, same pin order\nat both ends. The main board MOSFET pulls pin 2\nto GND to switch a channel on (5 V across the load)."
		(exclude_from_sim no)
		(at 13.97 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a4005879-2b66-5533-acce-73d3f7f81e08")
	)
	(text "Input 5 V / 440 ohm (about 11 mA). Load 0.1-2 A at 75-264 VAC.\nRV1: MOV across the load pins (150 VAC rms, 240 V varistor voltage) clamps\nthe solenoid turn-off spike (Omron: add overvoltage protection on inductive loads).\nMinimum load 0.1 A and off-state leakage up to 1 mA: check the valve current."
		(exclude_from_sim no)
		(at 90.17 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c87b543c-9e69-5f54-835a-1bade8695e77")
	)
