	(text "J pins: 1 = switch common (3.3 V only - never 5 V or mains),\n2 = Coffee, 3 = Steam. 10k sets a firm OFF level; 1k + 100 nF\nfilter noise. LED (330R, ~4 mA from the switch) = switch ON."
		(exclude_from_sim no)
		(at 317.5 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "048ccf49-7fc9-5f03-a10b-e3fd38949c23")
	)
	(text "Coffee / Steam switches (3.3 V = ON)"
		(exclude_from_sim no)
		(at 316.23 138.43 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
