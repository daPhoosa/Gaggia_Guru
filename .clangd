# clangd config for an ESP32 (Xtensa GCC) PlatformIO project.
# Regenerate compile_commands.json after changing libs/flags:
#   pio run -e esp32-serial -t compiledb
CompileFlags:
  Remove:
    - -mlongcalls
    - -mtext-section-literals
    - -mfix-esp32-psram-cache-issue
    - -mfix-esp32-psram-cache-strategy=*
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -freorder-blocks
    - -fipa-pta
  Add:
    - -Wno-unknown-warning-option
Diagnostics:
  Suppress:
    - drv_unknown_argument
    - drv_unsupported_opt
---
# Unit tests (test/<suite>/test_main.cpp) build for the PC with `pio test -e native`
# and aren't in compile_commands.json. Paths are relative to the test file's folder.
If:
  PathMatch: test/.*\.cpp
CompileFlags:
  CompilationDatabase: None
  Add:
    - -std=gnu++17
    - -I../../src
    - -I../../include
    - -I../../.pio/libdeps/native/Unity/src
